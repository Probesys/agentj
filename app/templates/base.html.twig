<!doctype html>
<html  lang="{{ app.request.locale }}">
  <head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="turbo-cache-control" content="no-cache">
    <meta name="turbo-prefetch" content="false">
    <link rel="manifest" href="{{ asset('site.webmanifest') }}">
    {% block head_css %}
      <link rel="shortcut icon" href="{{ asset('favicon.ico') }}" />
    {% endblock %}

      {{ encore_entry_link_tags('app') }}
      {{ encore_entry_script_tags('app') }}

    {% block head_js %}{% endblock %}

    <title>{% block title %}{% endblock %} | {{ 'Navigation.mainSubTitle'|trans }}</title>
  </head>

  {% set bodyClass="" %}
  {%  if app.request.get('_route') == 'human_authentication' %}
    {% set bodyClass="validate-address" %}
  {% endif %}

  <body id="page-top" data-base-path="{{ app.request.basePath }}" class="{{ bodyClass }}">
    {% block topnav %}

        {{ render(controller(
                      'App\\Controller\\MenuController::renderHeader'
                  )) }}
    {% endblock %}
    <div class="page-wrapper default-theme sidebar-bg bg1 toggled">

      {% include 'navigation.html.twig' %}

      <main class="page-content">
        <div id="overlay" class="overlay"></div>

        <div class="container-fluid mb-5 mt-5">
          {% include 'alerts.html.twig' %}
          {% block body %}

          {% endblock %}
        </div>
      </main>
      {% block footer %}
        {% include '_footer.html.twig' %}
          <a class="scroll-to-top" href="#page-top" style="display: none;">
            <i class="fas fa-sort-up"></i>
          </a>
      {% endblock %}
    </div>

    {% block bottom_js %}



    {% endblock %}
    {% include '_toast.html.twig' %}
    <div id="dialog-confirm" title="" style="display:none;">
      <div id="dialog-content"></div>
    </div>


    <div id="empModal" class="modal" tabindex="-1" role="dialog">

    </div>
    <script>
        window.jsTranslations = {{ {
            'Message.Actions.massiveActionContent': 'Message.Actions.massiveActionContent' | trans,
            'Generics.flash.editSuccess': 'Generics.flash.editSuccess' | trans,
            'Generics.labels.yes': 'Generics.labels.yes' | trans,
            'Generics.labels.cancel': 'Generics.labels.cancel' | trans,
            'Navigation.untreated': 'Navigation.untreated' | trans,
            'Navigation.authorized': 'Navigation.authorized' | trans,
            'Navigation.banned': 'Navigation.banned' | trans,
            'Navigation.Messagedelete': 'Navigation.Messagedelete' | trans,
            'Navigation.MessageRestored': 'Navigation.MessageRestored' | trans,
            'Navigation.mailBlocked': 'Navigation.mailBlocked' | trans,
        } | json_encode | raw }};
    </script>
  </body>
</html>
