<!doctype html>
<html  lang="{{ app.request.locale }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="turbo-prefetch" content="false">
    <link rel="manifest" href="{{ asset('site.webmanifest') }}">
    {% block head_css %}
      <link rel="shortcut icon" href="{{ asset('favicon.ico') }}" />
    {% endblock %}
      {{ encore_entry_link_tags('app') }}
    <title>{% block title %}{% endblock %}</title>
  </head>

  {% set bodyClass="" %}
  {%  if app.request.get('_route') == 'app_login' %}
    {% set bodyClass="not-auth" %}
  {% elseif app.request.get('_route') == 'human_authentication' %}
    {% set bodyClass="validate-address" %}
  {% endif %}

  <body id="page-top" data-base-path="{{ app.request.basePath }}" class="not-auth" data-turbo="false">
    <div class="page-wrapper default-theme sidebar-bg bg1">
      <main class="page-content">
        <div id="overlay" class="overlay"></div>

        <div class="container-fluid mb-5 mt-5">
          {% block body %}

          {% endblock %}
        </div>
      </main>
      {% block footer %}
        {% include '_footer.html.twig' %}
      {% endblock %}
    </div>


    {% block bottom_js %}
    {% endblock %}

    </div>
  </body>
</html>
