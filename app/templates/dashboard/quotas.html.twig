<turbo-frame id="dashboard-quotas">
    <div data-test="quotas-content">
        <div class="row gx-1">
            {% if usage is empty %}
                <div class="col-12">
                    <p>
                        {{ 'Message.Dialogs.quotas.noQuota' | trans }}
                    </p>
                </div>
            {% else %}
                {% for unitUse in usage %}
                    {% set percentage = unitUse.limit > 0
                        ? ((unitUse.current / unitUse.limit) * 100)|round
                        : 0
                    %}

                    <div class="col-md-4 mb-0">
                        <div class="card h-100">
                            <div class="card-body">
                                <div
                                    class="progress mb-3"
                                    style="height: 20px;"
                                    role="progressbar"
                                    aria-valuenow="{{ min(percentage, 100) }}"
                                    aria-valuemin="0"
                                    aria-valuemax="100"
                                    aria-label="Utilisation du quota"
                                >
                                    <div
                                        data-test="percentage"
                                        class="progress-bar text-dark {% if percentage >= 90 %}bg-danger{% elseif percentage >= 70 %}bg-warning{% else %}bg-success{% endif %}"
                                        style="width: {{ min(percentage, 100) }}%;"
                                    >
                                        {{ percentage }}%
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between gap-1 mb-1">
                                    <span>{{ 'Message.Dialogs.quotas.period' | trans }}</span>
                                    <strong data-test="period">{{ unitUse.period | duration }}</strong>
                                </div>

                                <div class="d-flex justify-content-between gap-1 mb-1">
                                    <span>{{ 'Message.Dialogs.quotas.limit' | trans }}</span>
                                    <strong data-test="limit">{{ unitUse.limit }}</strong>
                                </div>

                                <div class="d-flex justify-content-between gap-1 mb-1">
                                    <span>{{ 'Message.Dialogs.quotas.usage' | trans }}</span>
                                    <strong data-test="usage">{{ unitUse.current }}</strong>
                                </div>

                                <div class="d-flex justify-content-between gap-1 mb-1">
                                    <span>{{ 'Message.Dialogs.quotas.remaining' | trans }}</span>
                                    <strong data-test="remaining">{{ unitUse.remaining }}</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</turbo-frame>
