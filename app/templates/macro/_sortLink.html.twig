{% macro sortLink(title, sortField) %}
  {%  set sortDirection = 'asc' %}
  {% if app.request.get('sortDirection') == 'asc' and sortField == app.request.get('sortField')%}
    {%  set sortDirection = 'desc' %}
  {% endif %}

  {% set params = app.request.get('_route_params')|merge({'sortField': sortField, 'sortDirection': sortDirection}) %}
  {% if app.request.get('search') is not empty %}
    {% set params = params|merge({'search': app.request.get('search')}) %}
  {% endif %}

  <a href="{{ path(app.request.get('_route'), params) }}">{{ title }}</a>

{% endmacro %}
