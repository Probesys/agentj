{% extends 'modalTemplate.html.twig' %}

{% block modalTitle %}
	{{ 'Entities.Message.labels.preview' | trans }}
{% endblock %}

{% block modalContent %}
	{% if not messageRecipient.isVirus %}
		<iframe sandbox style="width:100%;min-height:400px;border:none" src="{{ path('message_show_iframe_content', { 'partitionTag' : messageRecipient.partitionTag, 'mailId' : messageRecipient.mailId, 'rseqnum':messageRecipient.rseqnum}) }}"></iframe>
		{% if not messageRecipient.isAmavisReleaseOngoing %}
            <div class="row text-center">
                <form
                    id="{{ 'restore' ~ messageRecipient.partitionTag ~ '-' ~ messageRecipient.mailId ~ '-' ~ messageRecipient.address.id }}"
                    action="{{path('message_restore', {
                        'partitionTag': messageRecipient.partitionTag,
                        'mailId': messageRecipient.mailId,
                        'rseqnum': messageRecipient.rseqnum,
                    })}}"
                    method="POST"
                >
                    <input type="hidden" name="_token" value="{{ csrf_token('message_restore') }}">
                    <button
                        type="submit"
                        class="btn confirmModal btn-primary"
                        data-dialog-title="{{ 'Message.Dialogs.confirmRestoreMsgtitle'|trans }}"
                        data-dialog-content="{{ 'Message.Dialogs.confirmRestoreMsgContent'|trans }}"
                        data-test="restore-button"
                        title='{{ 'Message.Actions.RestoreMessage'|trans }}'
                    >
                        <span class="fas fa-download"></span>
                        {{ 'Message.Actions.Restore'|trans }}
                    </button>
                </form>

                <form
                    id="{{ 'authorized' ~ messageRecipient.partitionTag ~ '-' ~ messageRecipient.mailId ~ '-' ~ messageRecipient.address.id }}"
                    action="{{path('message_authorized', {
                        'partitionTag':messageRecipient.partitionTag,
                        'mailId':messageRecipient.mailId,
                        'rseqnum':messageRecipient.rseqnum,
                    })}}"
                    method='POST'
                >
                    <input type="hidden" name="_token" value="{{ csrf_token('message_authorize') }}">
                    <button
                        type="submit"
                        class='btn confirmModal btn-success'
                        data-dialog-title='{{ 'Message.Dialogs.confirmAuthorizedMsgtitle'|trans }}'
                        data-dialog-content='{{ 'Message.Dialogs.confirmAuthorizedMsgContent'|trans }}'
                        data-test="authorize-button"
                        title='{{ 'Message.Actions.AutorizedSender'|trans }}'
                    >
                        <span class="fas fa-user-check "></span>
                        {{ 'Message.Actions.Autorized'|trans() }}
                    </button>
                </form>

                <form
                    id="{{ 'banned' ~ messageRecipient.partitionTag ~ '-' ~ messageRecipient.mailId ~ '-' ~ messageRecipient.address.id }}"
                    action="{{path('message_banned',{
                        'partitionTag':messageRecipient.partitionTag,
                        'mailId':messageRecipient.mailId,
                        'rseqnum':messageRecipient.rseqnum,
                    })}}"
                    method='POST'
                >
                    <input type="hidden" name="_token" value="{{ csrf_token('message_ban') }}">
                    <button
                        type="submit"
                        class='btn confirmModal btn-dark'
                        data-dialog-title='{{ 'Message.Dialogs.confirmBannedMsgtitle'|trans }}'
                        data-dialog-content='{{ 'Message.Dialogs.confirmBannedMsgContent'|trans }}'
                        data-test="ban-button"
                        title="{{ 'Message.Actions.BannedSender'|trans() }}"
                    >
                        <span class="fas fa-user-slash "></span>
                        {{ 'Message.Actions.Banned'|trans() }}
                    </button>
                </form>

                <form
                    id="{{ 'delete' ~ messageRecipient.partitionTag ~ '-' ~ messageRecipient.mailId ~ '-' ~ messageRecipient.address.id }}"
                    action="{{path('message_delete',{
                        'partitionTag':messageRecipient.partitionTag,
                        'mailId':messageRecipient.mailId,
                        'rseqnum':messageRecipient.rseqnum,
                    })}}"
                    method='POST'
                >
                    <input type="hidden" name="_token" value="{{ csrf_token('message_delete') }}">
                    <button
                        type="submit"
                        class='btn confirmModal btn-danger'
                        data-dialog-title='{{ 'Message.Dialogs.confirmDeleteMsgtitle'|trans }}'
                        data-dialog-content='{{ 'Message.Dialogs.confirmDeleteMsgContent'|trans }}'
                        data-target='delete'
                        data-test="delete-button"
                        title="{{ 'Message.Actions.DeleteMessage'|trans() }}"
                    >
                        <span class="fas fa-trash-alt "></span>
                        {{ 'Message.Actions.Delete'|trans() }}
                    </button>
                </form>
            </div>
        {% endif %}
	{% else %}
		<p class="text-center">
			{{ 'Generics.messages.cannotPreviewMailWithvirus' | trans }}
		</p>
	{% endif %}
{% endblock %}
