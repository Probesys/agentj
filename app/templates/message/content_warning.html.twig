{% extends 'modalTemplate.html.twig' %}

{% block modalTitle %}
	{{ 'Entities.Message.labels.preview' | trans }}
{% endblock %}

{% block modalContent %}
    <turbo-frame id="message-content">
        <div class="col-md-12 text-center">
            <p>
                {{ 'Entities.Message.warning.content'|trans }}
            </p>
        </div>

        <div class="d-flex justify-content-center">
            <button
                type="button"
                class="btn btn-secondary mx-2"
                data-dismiss="modal"
            >
                {{ 'Generics.actions.cancel'|trans }}
            </button>

            <a
                class="btn btn-primary mx-2"
                href="{{ path('message_show_content', {
                    'partitionTag': messageRecipient.partitionTag,
                    'mailId': messageRecipient.mailId,
                    'rseqnum': messageRecipient.rseqnum,
                    'warned': true,
                }) }}"
            >
                {{ 'Generics.actions.displayMessage'|trans }}
            </a>
        </div>
    </turbo-frame>
{% endblock %}
