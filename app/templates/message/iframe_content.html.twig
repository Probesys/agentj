{% if not messageRecipient.isVirus %}
	<div class="row">
		<div class="col-md-3 font-weight-bold">
			{{ 'Generics.fields.sender' | trans }}
		</div>
		<div class="col-md-9" data-test="content-sender">
			{{ from }}
		</div>
		<div class="col-md-3  font-weight-bold">
			{{ 'Generics.fields.object' | trans }}
		</div>
		<div class="col-md-9" data-test="content-subject">
			{{ subject}}
		</div>
		{% if attachments | length > 0 %}
			<div class="col-md-3  font-weight-bold">
				{{ 'Generics.fields.attachments' | trans }}
			</div>
			<div class="col-md-9">
				{% for attachmentName in attachments %}
					{{ attachmentName }}
					<br>
				{% endfor %}
			</div>
		{% endif %}
		{# The project stylesheets are not loaded in the iframe, hence the inline styles #}
		{% if htmlTooLarge or textTruncated %}
			<div
				data-test="content-preview-warning"
				style="margin: 1em 0; padding: .75em 1em; border: 1px solid #ffe69c; border-radius: .375rem; background: #fff3cd; color: #664d03;"
			>
				{% if htmlTooLarge and textTruncated %}
					{{ 'Generics.messages.htmlPreviewTooLargeTruncated' | trans }}
				{% elseif htmlTooLarge %}
					{{ 'Generics.messages.htmlPreviewTooLarge' | trans }}
				{% else %}
					{{ 'Generics.messages.previewTruncated' | trans }}
				{% endif %}
			</div>
		{% endif %}
		{% if htmlBody %}
			<div class="col-md-12" data-test="content-body">
				{{ htmlBody | raw}}
			</div>
		{% else %}
			<div class="col-md-12" data-test="content-body" style="white-space: pre-wrap">{{ textBody }}</div>
		{% endif %}
	</div>
{% else %}
	<p class="text-center">
		{{ 'Generics.messages.cannotPreviewMailWithvirus' | trans }}
	</p>
{% endif %}
