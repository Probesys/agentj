{% extends 'base.html.twig' %}

{% block title %}
    {{'Entities.Message.index'|trans()}}
    {{subTitle|trans()|lcfirst}}
{% endblock %}

{% block body %}
    {% set _title = 'Entities.Message.index'|trans() ~ ' ' ~ subTitle|trans()|lcfirst ~ ' : ' ~  messagesRecipients.getTotalItemCount %}
    {% embed 'common/blockTitleAndButtons.html.twig' %}
    {% endembed %}

    <p class="text-muted bg-white pb-0 mb-0 pl-3">
        {{'Entities.Message.informationMessage'|trans()}}
    </p>

    {% include 'common/blocActionsAndSearch.html.twig' %}

    <div class="table-responsive">
        <section id="no-more-tables">
            <table id="table_msgs" data-type-list-msgs="{{ messageStatus }}" class="table table-hover">
                <thead>
                    <tr>
                        {# it not virus #}
                        {% if messageStatus != '7' %}
                            <th>
                                <input form="massive-actions-form" type="checkbox" id='checkAll' class="cb" data-target-checkall-class="selected-msg">
                                <label class="for-cb check-all" for="checkAll"></label>
                            </th>
                        {% endif %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <th></th>
                        {% endif %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <th>
                                {{ knp_pagination_sortable(messagesRecipients, 'Message.Recipient'|trans,'maddr.email') }}
                            </th>
                        {% endif %}
                        <th>
                            {% if feature_flag_disable_sort_by_subject %}
                                {{ 'Message.Object'|trans }}
                            {% else %}
                                {{ knp_pagination_sortable(messagesRecipients, 'Message.Object'|trans, 'm.subject') }}
                            {% endif %}
                        </th>
                        <th>
                            {{ knp_pagination_sortable(messagesRecipients, 'Message.Sender'|trans, 'm.fromAddr') }}
                        </th>
                        <th>
                            {{ knp_pagination_sortable(messagesRecipients, 'Message.Date'|trans, 'm.timeNum') }}
                        </th>
                        {# it not virus #}
                        {% if messageStatus != '7' %}
                            <th>
                                {{ 'Entities.Message.spamLevel'|trans }}
                            </th>
                        {% endif %}
                        <th></th>
                        {# it not virus #}
                        {% if messageStatus != '7' %}
                            <th>
                                {{ 'Message.Actions.list'|trans() }}
                            </th>
                        {% endif %}
                    </tr>
                </thead>

                <tbody>
                    {% for msgRecipient in messagesRecipients %}
                        {% set error_badge = "" %}
                        {% set bold = "" %}

                        {% if msgRecipient.isUntreated %}
                            {% set bold = "bold" %}
                        {% elseif msgRecipient.isError %}
                            {% set bold = "bold" %}
                            {% set error_badge = 'Message.Status.Error' %}
                        {% endif %}

                        {% set keyPairMessage =  [msgRecipient.partitionTag, msgRecipient.mailId,msgRecipient.address.id] %}
                        <tr
                            class="{{bold}} ">
                            {# it not virus #}
                            {% if messageStatus != '7' %}
                                <td>
                                    {% if not msgRecipient.isAmavisReleaseOngoing %}
                                        <input
                                            form="massive-actions-form"
                                            type="checkbox"
                                            name="id[]"
                                            value="{{ keyPairMessage|json_encode() }}"
                                            id="msg-{{ msgRecipient.partitionTag }}-{{ msgRecipient.mailId }}-{{ msgRecipient.address.id }}"
                                            class="cb selected-msg"
                                        >
                                        <label class="for-cb"></label>
                                    {% endif %}
                                </td>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <td>
                                    <span title="{{ msgRecipient.mailId }}">
                                        {{ msgRecipient.mailId }}
                                    </span>
                                </td>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <td data-title="{{'Message.Recipient'|trans }}">
                                    <span title="{{msgRecipient.address.email}}">
                                        {{msgRecipient.address.email}}
                                    </span>
                                </td>
                            {% endif %}
                            <td
                                data-title="{{'Message.Object'|trans }}"
                                data-test="subject"
                            >
                                <span
                                    data-msg-id="{{ keyPairMessage|json_encode() }}"
                                    title="{{msgRecipient.message.subject|replace({'_':' '})}}"
                                >
                                    {{msgRecipient.message.subject|slice(0,30)|replace({'_':' '})}}
                                </span>
                            </td>
                            <td data-title="{{'Message.Sender'|trans }}">
                                {% if msgRecipient.message.fromAddr | length > 35 %}
                                    <span title="{{ 'Message.Sender'|trans ~ ' : ' ~ msgRecipient.message.fromAddr }}">
                                        {% for senderSplit in  msgRecipient.message.fromAddr |split('<') %}
                                            {% if (senderSplit | length > 35) and ('@' in senderSplit ) %}
                                                {% set email = senderSplit |split('@') %}
                                                {{ email.0 }}
                                                <br/>
                                                @
                                                {{ email.1 |replace({'>':''})}}
                                            {% else %}
                                                {{ senderSplit|replace({'>':''}) }}
                                            {% endif %}
                                        {% endfor %}
                                    </span>
                                {% else %}
                                    <span title="{{ 'Message.Sender'|trans ~ ' : ' ~ msgRecipient.message.fromAddr }}">
                                        {{  msgRecipient.message.fromAddr }}
                                    </span>
                                {% endif %}
                                {% if error_badge %}
                                    <span class="badge badge-pill badge-warning" title="{{ error_badge | trans }}">
                                        {{ error_badge | trans }}
                                    </span>
                                {% endif %}
                            </td>
                            <td data-title="{{'Message.Date'|trans }}">
                                <span
                                    title="{{'Message.Date'|trans ~ ' : ' ~ msgRecipient.message.timeNum | format_datetime('short', 'short') }}"
                                >
                                    {{msgRecipient.message.timeNum | format_datetime('short', 'short')}}
                                </span>
                            </td>
                            {% if not msgRecipient.isVirus %}
                                <td>
                                    {{ msgRecipient.bspamLevel }}
                                </td>
                            {% endif %}
                            <td>
                                <ul class="list-inline list-unstyled">
                                    <li class="list-inline-item">
                                        <a href="#"
                                            data-modal-method-type="GET"
                                            data-url-modal-content="{{ path(
                                                'message_show',
                                                {
                                                    'partitionTag' : msgRecipient.partitionTag,
                                                    'mailId' : msgRecipient.mailId,
                                                    'rseqnum' : msgRecipient.rseqnum,
                                                }
                                            ) }}"
                                            class="btn-open-modal btn btn-info float-right"
                                        >
                                            <i class="fas fa-info"></i>
                                        </a>
                                    </li>
                                    {% if msgRecipient.message.isInQuarantine %}
                                        <li class="list-inline-item">
                                            <a href="#"
                                                title="{{ 'Entities.Message.labels.preview' | trans }}"
                                                data-modal-method-type="GET"
                                                data-url-modal-content="{{ path(
                                                    'message_show_content',
                                                    {
                                                        'partitionTag' : msgRecipient.partitionTag,
                                                        'mailId' : msgRecipient.mailId,
                                                        'rseqnum' : msgRecipient.rseqnum,
                                                    }
                                                ) }}"
                                                class="btn-open-modal btn btn-info float-right"
                                            >
                                                <i class="fas fa-envelope-open"></i>
                                            </a>
                                        </li>
                                    {% endif %}
                                </ul>
                            </td>

                            {% if not msgRecipient.isVirus %}
                                <td>
                                    {% if msgRecipient.isAmavisReleaseOngoing %}
                                        <div
                                            class="btn btn-primary text-white"
                                            data-controller="button-pending-release-message"
                                            data-button-pending-release-message-partition-tag-value="{{ msgRecipient.partitionTag }}"
                                            data-button-pending-release-message-mail-id-value="{{ msgRecipient.mailId }}"
                                            data-button-pending-release-message-rseqnum-value="{{ msgRecipient.rseqnum }}"
                                            data-button-pending-release-message-url-value="{{
                                                path( 'message_release_status', {
                                                    'partitionTag': msgRecipient.partitionTag,
                                                    'mailId': msgRecipient.mailId,
                                                    'rseqnum': msgRecipient.rseqnum
                                                } ) }}"
                                        >
                                            <span id="buttonLoader" class="spinner-border spinner-border-sm" ></span>
                                        </div>
                                    {% else %}
                                        <div class="dropdown">
                                            <button class="btn btn-primary dropdown-toggle" type="button" data-toggle="dropdown" data-boundary="viewport">
                                                Action
                                            </button>
                                            <div class="dropdown-menu" style="z-index:10300">
                                                {# Restore action #}
                                                {% if msgRecipient.isUntreated or msgRecipient.isSpam or msgRecipient.isDeleted or msgRecipient.isBanned %}
                                                    <form
                                                        id="{{ 'restore' ~ msgRecipient.partitionTag ~ '-' ~ msgRecipient.mailId ~ '-' ~ msgRecipient.address.id }}"
                                                        action="{{path('message_restore', {
                                                            'partitionTag': msgRecipient.partitionTag,
                                                            'mailId': msgRecipient.mailId,
                                                            'rseqnum': msgRecipient.rseqnum,
                                                        })}}"
                                                        method="POST"
                                                    >
                                                        <input type="hidden" name="_token" value="{{ csrf_token('message_restore') }}">
                                                        <button
                                                            type="submit"
                                                            class="dropdown-item confirmModal text-success"
                                                            data-test="confirm-restore"
                                                            data-dialog-title="{{ 'Message.Dialogs.confirmRestoreMsgtitle'|trans }}"
                                                            data-dialog-content="{{ 'Message.Dialogs.confirmRestoreMsgContent'|trans }}"
                                                            title='{{ 'Message.Actions.RestoreMessage'|trans }}'
                                                        >
                                                            <span class="fas fa-download"></span>
                                                            {{ 'Message.Actions.Restore'|trans }}
                                                        </button>
                                                    </form>
                                                {% endif %}

                                                {# Authorize action #}
                                                {% if msgRecipient.isUntreated  or msgRecipient.isSpam or msgRecipient.isBanned or msgRecipient.isDeleted or msgRecipient.isRestored %}
                                                    <form
                                                        id="{{ 'authorized' ~ msgRecipient.partitionTag ~ '-' ~ msgRecipient.mailId ~ '-' ~ msgRecipient.address.id }}"
                                                        action="{{path('message_authorized', {
                                                            'partitionTag':msgRecipient.partitionTag,
                                                            'mailId':msgRecipient.mailId,
                                                            'rseqnum':msgRecipient.rseqnum,
                                                        })}}"
                                                        method='POST'
                                                    >
                                                        <input type="hidden" name="_token" value="{{ csrf_token('message_authorize') }}">
                                                        <button
                                                            type="submit"
                                                            class='dropdown-item confirmModal text-success'
                                                            data-dialog-title='{{ 'Message.Dialogs.confirmAuthorizedMsgtitle'|trans }}'
                                                            data-dialog-content='{{ 'Message.Dialogs.confirmAuthorizedMsgContent'|trans }}'
                                                            title='{{ 'Message.Actions.AutorizedSender'|trans }}'
                                                        >
                                                            <span class="fas fa-user-check "></span>
                                                            {{ 'Message.Actions.Autorized'|trans() }}
                                                        </button>
                                                    </form>
                                                {% endif %}

                                                {# Ban action #}
                                                {% if msgRecipient.isUntreated  or msgRecipient.isSpam or msgRecipient.isAuthorized or msgRecipient.isDeleted or msgRecipient.isRestored %}
                                                    <form
                                                        id="{{ 'banned' ~ msgRecipient.partitionTag ~ '-' ~ msgRecipient.mailId ~ '-' ~ msgRecipient.address.id }}"
                                                        action="{{path('message_banned',{
                                                            'partitionTag':msgRecipient.partitionTag,
                                                            'mailId':msgRecipient.mailId,
                                                            'rseqnum':msgRecipient.rseqnum,
                                                        })}}"
                                                        method='POST'
                                                    >
                                                        <input type="hidden" name="_token" value="{{ csrf_token('message_ban') }}">
                                                        <button
                                                            type="submit"
                                                            class='dropdown-item confirmModal'
                                                            data-dialog-title='{{ 'Message.Dialogs.confirmBannedMsgtitle'|trans }}'
                                                            data-dialog-content='{{ 'Message.Dialogs.confirmBannedMsgContent'|trans }}'
                                                            title="{{ 'Message.Actions.BannedSender'|trans() }}"
                                                        >
                                                            <span class="fas fa-user-slash "></span>
                                                            {{ 'Message.Actions.Banned'|trans() }}
                                                        </button>
                                                    </form>
                                                {% endif %}

                                                {# Delete action #}
                                                {% if msgRecipient.isUntreated  or msgRecipient.isSpam or msgRecipient.isAuthorized or msgRecipient.isBanned or msgRecipient.isRestored %}
                                                    <form
                                                        id="{{ 'delete' ~ msgRecipient.partitionTag ~ '-' ~ msgRecipient.mailId ~ '-' ~ msgRecipient.address.id }}"
                                                        action="{{path('message_delete',{
                                                            'partitionTag':msgRecipient.partitionTag,
                                                            'mailId':msgRecipient.mailId,
                                                            'rseqnum':msgRecipient.rseqnum,
                                                        })}}"
                                                        method='POST'
                                                    >
                                                        <input type="hidden" name="_token" value="{{ csrf_token('message_delete') }}">
                                                        <button
                                                            type="submit"
                                                            class='dropdown-item confirmModal text-danger'
                                                            data-dialog-title='{{ 'Message.Dialogs.confirmDeleteMsgtitle'|trans }}'
                                                            data-dialog-content='{{ 'Message.Dialogs.confirmDeleteMsgContent'|trans }}'
                                                            data-target='delete'
                                                            title="{{ 'Message.Actions.DeleteMessage'|trans() }}"
                                                        >
                                                            <span class="fas fa-trash-alt "></span>
                                                            {{ 'Message.Actions.Delete'|trans() }}
                                                        </button>
                                                    </form>
                                                {% endif %}


                                                {% if is_granted('ROLE_ADMIN') %}
                                                    <div class="dropdown-divider"></div>

                                                    <form
                                                        id="{{ 'authorized_domain' ~ msgRecipient.partitionTag ~ '-' ~ msgRecipient.mailId ~ '-' ~ msgRecipient.address.id }}"
                                                        action="{{path('message_authorized_domain',{
                                                            'partitionTag':msgRecipient.partitionTag,
                                                            'mailId':msgRecipient.mailId,
                                                            'rseqnum':msgRecipient.rseqnum,
                                                        })}}"
                                                        method='POST'
                                                    >
                                                        <input type="hidden" name="_token" value="{{ csrf_token('message_authorize_domain') }}">
                                                        <button
                                                            type="submit"
                                                            class='dropdown-item confirmModal text-success'
                                                            data-dialog-title='{{ 'Message.Dialogs.confirmAuthorizedDomainMsgtitle'|trans }}'
                                                            data-dialog-content='{{ 'Message.Dialogs.confirmAuthorizedDomainMsgContent'|trans }}'
                                                            title="{{ 'Message.Actions.AutorizedDomain'|trans() }}"
                                                        >
                                                            <span class="fas fa-check-double "></span>
                                                            {{ 'Message.Actions.Autorized'|trans() }}
                                                        </button>
                                                    </form>
                                                    <form
                                                        id="{{ 'banned_domain' ~ msgRecipient.partitionTag ~ '-' ~ msgRecipient.mailId ~ '-' ~ msgRecipient.address.id }}"
                                                        action="{{path('message_banned_domain',{
                                                            'partitionTag':msgRecipient.partitionTag,
                                                            'mailId':msgRecipient.mailId,
                                                            'rseqnum':msgRecipient.rseqnum,
                                                        })}}"
                                                        method='POST'
                                                    >
                                                        <input type="hidden" name="_token" value="{{ csrf_token('message_ban_domain') }}">
                                                        <button type="submit"
                                                            class='dropdown-item confirmModal'
                                                            data-dialog-title='{{ 'Message.Dialogs.confirmBannedDomainMsgtitle'|trans }}'
                                                            data-dialog-content='{{ 'Message.Dialogs.confirmBannedDomainMsgContent'|trans }}'
                                                            title="{{ 'Message.Actions.BannedDomain'|trans() }}"
                                                        >
                                                            <span class="fas fa-ban "></span>
                                                            {{ 'Message.Actions.Banned'|trans() }}
                                                        </button>
                                                    </form>

                                                    <div class="dropdown-divider"></div>

                                                    {% if msgRecipient.isUntreated or msgRecipient.isAuthorized or msgRecipient.isBanned or msgRecipient.isDeleted  or msgRecipient.isRestored %}
                                                        <form
                                                            id="{{ 'mark-as-spam' ~ msgRecipient.partitionTag ~ '-' ~ msgRecipient.mailId ~ '-' ~ msgRecipient.address.id }}"
                                                            action="{{path('message_mark_as_spam',{
                                                                'partitionTag': msgRecipient.partitionTag,
                                                                'mailId': msgRecipient.mailId,
                                                                'rseqnum': msgRecipient.rseqnum
                                                                })}}"
                                                            method='POST'
                                                        >
                                                            <input type="hidden" name="_token" value="{{ csrf_token('message_mark_as_spam') }}">
                                                            <button type="submit" class="dropdown-item">
                                                                <span class="fas fa-thumbs-down"></span>
                                                                {{ 'Message.Actions.MarkAsSpam' | trans }}
                                                            </button>
                                                        </form>
                                                    {% endif %}

                                                    {% if msgRecipient.isSpam  or msgRecipient.isRestored %}
                                                        <form
                                                            id="{{ 'mark-as-ham' ~ msgRecipient.partitionTag ~ '-' ~ msgRecipient.mailId ~ '-' ~ msgRecipient.address.id }}"
                                                            action="{{path('message_mark_as_ham',{
                                                                'partitionTag': msgRecipient.partitionTag,
                                                                'mailId': msgRecipient.mailId,
                                                                'rseqnum': msgRecipient.rseqnum
                                                            })}}"
                                                            method='POST'
                                                        >
                                                            <input type="hidden" name="_token" value="{{ csrf_token('message_mark_as_ham') }}">
                                                            <button type="submit" class="dropdown-item">
                                                                <span class="fas fa-thumbs-up"></span>
                                                                {{ 'Message.Actions.MarkAsHam' | trans }}
                                                            </button>
                                                        </form>
                                                    {% endif %}
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>

                    {% endfor %}
                </tbody>
            </table>
        </section>
    </div>

    <div class="navigation text-center">
        {{ knp_pagination_render(messagesRecipients) }}
    </div>

{% endblock %}
