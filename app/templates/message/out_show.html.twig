{% extends 'modalTemplate.html.twig' %}
{% set msgDeliveryStatus = {'D' : 'Deffered', 'P' : 'Passed', 'B' : 'Bounce' } %}
{% block modalTitle %}
  {#  {{ 'Entities.Group.Actions.updateGroup'|trans }}#}
  {{ 'Entities.Msgrcpt.labels.infos' | trans }}
{% endblock %}
{% block modalContent %}
    {% for message in messages %}
        <div class="row">
    <div class="col-md-4">
      {{ 'Generics.fields.date' | trans }}
    </div>
    <div class="col-md-8">
      {{ outMessage.time_iso | format_datetime('short', 'short') }}
    </div>
    <div class="col-md-4">
       {{ 'Generics.fields.sender' | trans }}
    </div>
    <div class="col-md-8">
      {{ message.from_addr }}
    </div>
    <div class="col-md-4">
      {{ 'Generics.fields.recipient' | trans }}
    </div>
    <div class="col-md-8">
      {{ message.email }}
    </div>
    <div class="col-md-4">
     {{ 'Entities.Msgrcpt.fields.bspamLevel' | trans }}
    </div>
    <div class="col-md-8">
      {{ outMessageRecipient.bspam_level }}
    </div>

    {% if outMessageRecipient.send_captcha > 0 %}
    <div class="col-md-4">
      {{ 'Entities.Message.dateAuthRequestAt' | trans }} :
    </div>
    <div class="col-md-8">
       {{ outMessageRecipient.send_captcha | format_datetime('short', 'short') }}
    </div>
    {% endif %}

    <div class="col-md-4">
      {{ 'Entities.Message.isMailingList' | trans }}
    </div>
    <div class="col-md-8">
       {%  if outMessage.is_mlist %}{{ 'Generics.labels.yes' | trans() }} {% else %} {{ 'Generics.labels.no' | trans() }} {% endif %}
    </div>
    <div class="col-md-4">
      {{ 'Message.Status.title' | trans }}
    </div>
    <div class="col-md-8">
        {% set msgsStatus = msgDeliveryStatus[outMessageRecipient.ds] %}
        {% set response = outMessageRecipient.smtp_resp %}
        {% if outMessageRecipient.ds == 'P' %}
          {% set deliverySatusClass = 'text-success' %}
        {% else %}
          {% set deliverySatusClass = 'text-danger' %}
        {% endif %}

      <span class="{{ deliverySatusClass }}">{{ msgsStatus }}</span><br>
      <em>{{ response }}</em>
    </div>
    <div class="col-md-12">
       {{ 'Entities.Msgrcpt.labels.appliedRule' | trans }}
    </div>
    <div class="col-md-12">
      <table class="table table-sm">
        <thead>
          <tr>
            <th>{{ 'Generics.fields.recipient' | trans }}</th>
            <th>{{ 'Generics.fields.sender' | trans }}</th>
          </tr>
        </thead>
            {% set classTr = "" %}
            {% if loop.index == 1 %}
            {% set classTr = "bg-success text-white" %}
            {% endif %}
          <tr class="{{ classTr }} ">
            <td>{{ message.email }}</td>
            <td>{{ message.from_addr }}</td>
          </tr>
        {% endfor %}
      </table>
    </div>
  </div>

{% endblock %}
