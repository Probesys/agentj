{% extends 'modalTemplate.html.twig' %}

{% set msgDeliveryStatus = {'D' : 'Deffered', 'P' : 'Passed', 'B' : 'Bounce' } %}
{% set fromAddress = message.from %}

{% block modalTitle %}
    {{ 'Entities.Msgrcpt.labels.infos' | trans }}
{% endblock %}

{% block modalContent %}
    <div class="row">
        <div class="col-md-4">
            {{ 'Generics.fields.date' | trans }}
        </div>
        <div class="col-md-8" data-test="content-date">
            {{ message.timeiso | format_datetime('short', 'short') }}
        </div>
        {% if fromAddress %}
            <div class="col-md-4">
                {{ 'Generics.fields.sender' | trans }}
            </div>
            <div class="col-md-8" data-test="content-from">
                {{ message.fromAddr }}
            </div>
            {% if message.senderAddress.email != fromAddress %}
                <div class="col-md-4">
                    {{ 'Generics.fields.envelopeAddress' | trans }}
                </div>
                <div class="col-md-8" data-test="content-envelope-from">
                    {{ message.senderAddress.email }}
                </div>
            {% endif %}
        {% else %}
            <div class="col-md-4">
                {{ 'Generics.fields.sender' | trans }}
            </div>
            <div class="col-md-8" data-test="content-envelope-from">
                {{ message.senderAddress.email }}
            </div>
        {% endif %}
        <div class="col-md-4">
            {{ 'Generics.fields.recipient' | trans }}
        </div>
        <div class="col-md-8" data-test="content-recipient-email">
            {{ messageRecipient.address.email }}
        </div>

        {% set spamIndicators = message.spamIndicators %}
        <div class="col-md-4">
            {{ 'Entities.Msgrcpt.fields.bspamLevel' | trans }}
        </div>
        <div class="col-md-8" data-test="content-spam-rating">
            {{ messageRecipient.bspamLevel }}

            {% if spamIndicators is not empty %}
                <button
                    type="button"
                    class="btn btn-outline-info btn-sm ml-2"
                    data-toggle="collapse"
                    data-target="#message-spam-indicators"
                    aria-expanded="false"
                    aria-controls="message-spam-indicators"
                    data-test="spam-indicators-toggle"
                    title="{{ 'Entities.Msgrcpt.labels.spamIndicators' | trans }}"
                >
                    {{ 'Generics.labels.details' | trans }}
                    <i class="fas fa-chevron-down ml-1" aria-hidden="true"></i>
                </button>
            {% endif %}
        </div>

        {% if spamIndicators is not empty %}
            <div class="col-12 collapse" id="message-spam-indicators" data-test="spam-indicators">
                <ul class="list-unstyled mt-2 mb-2 p-2 bg-light" aria-label="{{ 'Entities.Msgrcpt.labels.spamIndicators' | trans }}">
                    {% for spamIndicator in spamIndicators %}
                        {% if spamIndicator.score > 0 %}
                            {% set badgeClass = 'badge-danger' %}
                            {% set badgeTitle = 'Entities.Msgrcpt.labels.spamIndicatorIncreases' | trans %}
                        {% elseif spamIndicator.score < 0 %}
                            {% set badgeClass = 'badge-success' %}
                            {% set badgeTitle = 'Entities.Msgrcpt.labels.spamIndicatorDecreases' | trans %}
                        {% else %}
                            {% set badgeClass = 'badge-secondary' %}
                            {% set badgeTitle = '' %}
                        {% endif %}

                        <li class="mb-2 text-break" data-test="spam-indicator">
                            {% if spamIndicator.score is not null %}
                                <span
                                    class="badge {{ badgeClass }}"
                                    title="{{ badgeTitle }}"
                                    data-test="spam-indicator-score"
                                >
                                    {{ spamIndicator.score > 0 ? '+' : '' }}{{ spamIndicator.score }}
                                </span>
                            {% endif %}
                            {{ spamIndicator.indicator.label | trans }}
                            <span class="text-muted small">({{ spamIndicator.rules | join(', ') }})</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if message.sendCaptcha > 0 and not message.isMlist %}
            <div class="col-md-4">
                {{ 'Entities.Message.dateAuthRequestAt' | trans }}
                :
            </div>
            <div class="col-md-8" data-test="content-auth-request-date">
                {{ message.sendCaptcha | format_datetime('short', 'short') }}
            </div>
        {% endif %}

        <div class="col-md-4">
            {{ 'Entities.Message.isMailingList' | trans }}
        </div>
        <div class="col-md-8" data-test="content-mailing-list">
            {%  if message.isMlist %}
                {{ 'Generics.labels.yes' | trans() }}
            {% else %}
                {{ 'Generics.labels.no' | trans() }}
            {% endif %}
        </div>

        {% if message.isMlist %}
            <div class="col-md-4">
                {{ 'Entities.Message.listId' | trans }}
            </div>
            <div class="col-md-8">
                {{ listMetadata.listId ?? 'Entities.Message.listIdUnknown' | trans }}
            </div>

            <div class="col-md-4">
                {{ 'Entities.Message.unsubscribeMethod' | trans }}
            </div>
            <div class="col-md-8">
                {% if unsubscribeMethods %}
                    {% set unsubscribeMethod = unsubscribeMethods.preferredMethod %}
                    {{ ('Entities.Message.unsubscribeMethods.' ~ unsubscribeMethod) | trans }}
                    <br>
                    <span class="text-break">
                        {{ unsubscribeMethod == 'mailto' ? unsubscribeMethods.mailtoAddresses|join(', ') : unsubscribeMethods.httpsUrl }}
                    </span>
                {% else %}
                    {{ 'Entities.Message.unsubscribeMethods.none' | trans }}
                {% endif %}
            </div>

            {% if lastUnsubscribeRequest %}
                <div class="col-md-4">
                    {{ 'Entities.Message.lastUnsubscribeRequest' | trans }}
                </div>
                <div class="col-md-8">
                    {{ ('Message.Unsubscribe.status.' ~ lastUnsubscribeRequest.status) | trans({
                        'date': lastUnsubscribeRequest.createdAt | format_date('short'),
                    }) }}
                </div>
            {% endif %}
        {% endif %}

        <div class="col-md-4">
            {{ 'Message.Status.title' | trans }}
        </div>
        <div class="col-md-8" data-test="content-status">
            {% if messageRecipient.isAlreadyReleased %}
                {% set deliveryStatusClass = 'text-success' %}
                {% set msgsStatus = messageRecipient.statusLabel | trans %}
                {% set response = messageRecipient.amavisOutput %}
            {% else %}
                {% set deliveryStatusClass = 'text-danger' %}
                {% set msgsStatus = msgDeliveryStatus[messageRecipient.ds] %}
                {% set response = messageRecipient.smtpResp %}
            {% endif %}

            <span class="{{ deliveryStatusClass }}">
                {{ msgsStatus }}
            </span>
            <br>
            <em>
                {{ response }}
            </em>
        </div>
        <div class="col-md-12">
            {{ 'Entities.Msgrcpt.labels.appliedRule' | trans }}
        </div>
        <div class="col-md-12 table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>
                            {{ 'Generics.fields.recipient' | trans }}
                        </th>
                        <th>
                            {{ 'Generics.fields.sender' | trans }}
                        </th>
                        <th>
                            {{ 'Entities.SenderRule.fields.wbRule' | trans }}
                        </th>
                        <th>
                            {{ 'Generics.fields.priority' | trans }}
                        </th>
                        <th>
                            {{ 'Entities.User.fields.group' | trans }}
                        </th>
                    </tr>
                </thead>
                {% for senderRule in senderRules %}
                    {% set classTr = "" %}
                    {% if loop.index == 1 %}
                        {% set classTr = "bg-success text-white" %}
                    {% endif %}
                    <tr class="{{ classTr }} ">
                        <td data-test="recipient-email">
                            {{ senderRule.user.email }}
                        </td>
                        <td data-test="sender-email">
                            {{ senderRule.senderRuleAddress.email }}
                        </td>
                        <td data-test="rule-name">
                            {{ senderRule.wbRuleName | trans }}
                        </td>
                        <td data-test="rule-priority">
                            {{ senderRule.priority }}
                        </td>
                        <td data-test="group">
                            {{ senderRule.group?.name }}
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>

{% endblock %}
