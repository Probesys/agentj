{% extends 'modalTemplate.html.twig' %}

{% block modalTitle %}
    {{ 'Entities.User.actions.add_new_alias_for'|trans({'email': user.email}) }}
{% endblock %}

{% block modalContent %}
    {{ form_start(form, {
        action: path('new_user_email_alias', {'id': user.id}),
        attr: {class: 'modal-ajax-form'},
    }) }}
        {{ form_row(form.email) }}

        <div class="d-flex justify-content-center">
            <input type="submit" class="btn btn-primary mr-2" value="{{ 'Generics.actions.save'|trans }}">
            <a class="btn btn-outline-secondary btn-close-modal" href="#">{{ 'Generics.actions.cancel'|trans }}</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
